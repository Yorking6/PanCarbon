{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "activity_ledger",
  "description": "Signed, standardized activity data. This is the only permitted input to the calculation engine. Every row carries its conversion chain, evidence and human sign-off.",
  "type": "object",
  "required": ["schema_version", "config_hash", "rows"],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "config_hash": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "row_id",
          "entity_ref",
          "period",
          "scope",
          "raw",
          "normalized",
          "conversion_chain",
          "data_quality",
          "estimated",
          "evidence_files",
          "confirmation"
        ],
        "properties": {
          "row_id": { "type": "string", "minLength": 1 },
          "entity_ref": { "type": "string", "minLength": 1 },
          "source_key": { "type": ["string", "null"] },
          "gas": { "type": "string" },
          "scope2_mode": {
            "type": ["string", "null"],
            "enum": ["location_based", "market_based", null]
          },
          "period": {
            "type": "object",
            "required": ["start", "end", "basis"],
            "properties": {
              "start": { "type": "string", "minLength": 1 },
              "end": { "type": "string", "minLength": 1 },
              "basis": {
                "type": "string",
                "enum": ["consumption", "billing", "estimated"]
              },
              "billing_note": { "type": ["string", "null"] }
            }
          },
          "scope": { "type": "string", "enum": ["S1", "S2", "S3"] },
          "iso_category": { "type": ["string", "null"] },
          "s3_category": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 15
          },
          "raw": {
            "type": "object",
            "required": ["value", "unit", "source_file", "extractor"],
            "properties": {
              "value": { "type": ["number", "string"] },
              "unit": { "type": "string", "minLength": 1 },
              "source_file": { "type": "string", "minLength": 1 },
              "source_locator": { "type": ["string", "null"] },
              "extractor": { "type": "string", "minLength": 1 },
              "confidence": { "type": "string" }
            }
          },
          "normalized": {
            "type": "object",
            "required": ["value", "unit"],
            "properties": {
              "value": { "type": "number" },
              "unit": { "type": "string", "minLength": 1 }
            }
          },
          "conversion_chain": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["op", "factor", "note"],
              "properties": {
                "op": { "type": "string", "minLength": 1 },
                "from_unit": { "type": ["string", "null"] },
                "to_unit": { "type": ["string", "null"] },
                "factor": { "type": ["number", "null"] },
                "reference": { "type": ["string", "null"] },
                "note": { "type": "string" }
              }
            }
          },
          "data_quality": {
            "type": "object",
            "required": ["activity", "factor", "instrument"],
            "properties": {
              "activity": { "type": "string", "enum": ["X", "Y", "Z"] },
              "factor": {
                "type": "string",
                "enum": ["A", "B", "C", "D", "E", "F"]
              },
              "instrument": { "type": "string", "enum": ["L", "M", "S"] }
            }
          },
          "estimated": { "type": "boolean" },
          "estimation_note": { "type": ["string", "null"] },
          "carry_over_from": { "type": ["string", "null"] },
          "evidence_files": { "type": "array", "items": { "type": "string" } },
          "confirmation": {
            "type": "object",
            "required": ["signed_by", "signed_at"],
            "properties": {
              "signed_by": { "type": "string", "minLength": 1 },
              "signed_at": { "type": "string", "minLength": 1 },
              "method": { "type": "string" },
              "confidence": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
