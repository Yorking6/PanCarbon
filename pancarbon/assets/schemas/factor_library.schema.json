{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "factor_library",
  "description": "Runtime-injected emission factor library. The Skill package ships an empty structure only. Scale is explicit so that the calculation engine never hardcodes a divisor.",
  "type": "object",
  "required": ["schema_version", "factors"],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "factors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "value",
          "unit",
          "applicability",
          "source",
          "gwp_version",
          "quality",
          "scale"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "value": { "type": "number", "minimum": 0 },
          "unit": { "type": "string", "minLength": 1 },
          "gases": { "type": "object" },
          "applicability": {
            "type": "object",
            "required": ["activity", "method"],
            "properties": {
              "activity": { "type": "string", "minLength": 1 },
              "region": { "type": ["string", "null"] },
              "year": { "type": ["integer", "null"] },
              "method": { "type": "string", "minLength": 1 }
            }
          },
          "source": {
            "type": "object",
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "url": { "type": ["string", "null"] },
              "retrieved_at": { "type": ["string", "null"] }
            }
          },
          "gwp_version": {
            "type": "string",
            "enum": ["AR4", "AR5", "AR6", "not_applicable"]
          },
          "valid_from": { "type": ["string", "null"] },
          "valid_to": { "type": ["string", "null"] },
          "priority": { "type": "integer" },
          "quality": { "type": "string", "enum": ["A", "B", "C", "D", "E", "F"] },
          "scale": {
            "type": "number",
            "minimum": 0,
            "description": "Explicit denominator in tco2e = ad * ef * gwp / scale. Must come from the unit contract, never from a hardcoded constant."
          },
          "note": { "type": ["string", "null"] }
        }
      }
    }
  }
}
