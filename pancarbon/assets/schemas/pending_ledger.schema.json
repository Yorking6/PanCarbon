{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pending_ledger",
  "description": "Stage 1 output: voucher-derived candidate rows awaiting human sign-off. Calculation is forbidden until confirm_gate.py produces a signed activity_ledger.json.",
  "type": "object",
  "required": ["schema_version", "config_hash", "rows"],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "config_hash": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "row_id", "period", "raw", "normalized", "conversion_chain",
          "data_quality", "estimated", "evidence_files", "confirmation",
          "needs_manual"
        ],
        "properties": {
          "row_id": { "type": "string", "minLength": 1 },
          "entity_ref": { "type": ["string", "null"] },
          "source_key": { "type": ["string", "null"] },
          "scope": { "type": ["string", "null"] },
          "s3_category": { "type": ["integer", "null"] },
          "gas": { "type": "string" },
          "scope2_mode": { "type": ["string", "null"] },
          "period": {
            "type": "object",
            "required": ["start", "end", "basis"],
            "properties": {
              "start": { "type": "string" },
              "end": { "type": "string" },
              "basis": { "type": "string", "enum": ["consumption", "billing", "estimated"] },
              "billing_note": { "type": ["string", "null"] },
              "confidence": { "type": "string" },
              "needs_manual": { "type": "boolean" },
              "warnings": { "type": "array", "items": { "type": "string" } }
            }
          },
          "raw": {
            "type": "object",
            "required": ["unit", "source_file", "extractor"],
            "properties": {
              "value": { "type": ["number", "string", "null"] },
              "unit": { "type": "string" },
              "source_file": { "type": "string" },
              "source_locator": { "type": ["string", "null"] },
              "extractor": { "type": "string" },
              "confidence": { "type": "string" }
            }
          },
          "normalized": {
            "type": "object",
            "required": ["value", "unit"],
            "properties": {
              "value": { "type": ["number", "null"] },
              "unit": { "type": "string" }
            }
          },
          "conversion_chain": { "type": "array", "items": { "type": "object" } },
          "data_quality": {
            "type": "object",
            "required": ["activity", "factor", "instrument"],
            "properties": {
              "activity": { "type": "string", "enum": ["X", "Y", "Z"] },
              "factor": { "type": "string", "enum": ["A", "B", "C", "D", "E", "F"] },
              "instrument": { "type": "string", "enum": ["L", "M", "S"] }
            }
          },
          "estimated": { "type": "boolean" },
          "estimation_note": { "type": ["string", "null"] },
          "carry_over_from": { "type": ["string", "null"] },
          "evidence_files": { "type": "array", "items": { "type": "string" } },
          "confirmation": {
            "type": "object",
            "required": ["signed_by", "signed_at"],
            "properties": {
              "signed_by": { "type": ["string", "null"] },
              "signed_at": { "type": ["string", "null"] },
              "method": { "type": "string" },
              "confidence": { "type": "string" }
            }
          },
          "needs_manual": { "type": "boolean" },
          "exclude": {
            "type": "boolean",
            "description": "Human reviewer marks a non-activity row for exclusion at Stage 2."
          },
          "warnings": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "extractor_stats": { "type": "object" }
  }
}
