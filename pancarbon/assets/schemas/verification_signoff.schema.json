{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verification_signoff",
  "description": "Human-supplied authorization for report mode B. Every field is supplied at run time; the Skill never infers or writes a verification conclusion.",
  "type": "object",
  "required": [
    "signed_by",
    "signed_at",
    "assurance_level",
    "materiality",
    "verifier",
    "statement"
  ],
  "properties": {
    "signed_by": { "type": "string", "minLength": 1 },
    "signed_at": { "type": "string", "minLength": 1 },
    "assurance_level": { "type": "string", "enum": ["limited", "reasonable"] },
    "materiality": { "type": "number", "minimum": 0 },
    "verifier": { "type": "string", "minLength": 1 },
    "statement": {
      "type": "string",
      "minLength": 1,
      "description": "Verbatim verification statement supplied by the authorized verifier. Never generated by the Skill."
    },
    "procedures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "type": "string" },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "category", "status"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "category": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    }
  }
}
